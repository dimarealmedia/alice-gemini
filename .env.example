# Required: Google AI Studio Gemini API key
GEMINI_API_KEY=

# Required for internet search; if omitted, regular Gemini answers still work
SERPER_API_KEY=

# Optional; default is a fast and cost-efficient Gemini model
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional; your city, used when a weather or "nearby" question names no city
HOME_CITY=

# Optional; country for search results (two letters: ru, il, us...). Default: ru
SEARCH_COUNTRY=ru
